<%!--
  The second of a hard delete's six statements: see `DeleteStream.hard_delete/3`. Takes the
  stream's events in the `event_id` order `lock_link_events` takes them in, FOR UPDATE because
  that is what conflicts with a link's KEY SHARE. It is a statement of its own and not a CTE of
  the delete, so the delete's snapshot starts after any wait here. A row a concurrent delete
  removed is skipped. Any row lock needs UPDATE on the table, so a hard delete needs it on
  `events`, as it does on `event_tags`.
--%>
SELECT e.event_id
FROM "<%= schema %>".events e
WHERE e.event_id IN (
  SELECT event_id
  FROM "<%= schema %>".stream_events
  WHERE stream_id = $1
)
ORDER BY e.event_id
FOR UPDATE OF e;
