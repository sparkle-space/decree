<%!--
  A link's check of where its events came from: see `Appender.link/4`. A `RecordedEvent` says
  which stream it was appended to, and a caller can change that, so these rows decide. Every
  row of an event carries the same original stream, a linking stream's row too, so `DISTINCT`
  answers one row per stream. The caller holds the events' rows by now, so a hard delete cannot
  remove these, and this takes no locks of its own.
--%>
SELECT DISTINCT streams.stream_uuid
FROM "<%= schema %>".stream_events
INNER JOIN "<%= schema %>".streams
  ON streams.stream_id = stream_events.original_stream_id
WHERE stream_events.event_id = ANY($1::uuid[]);
